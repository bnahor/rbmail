# Public URL used to build OAuth callback URLs.
APP_URL=http://localhost:3000

# Better Auth signs per-user sessions with this server secret.
# Use at least 32 high-entropy characters in production.
BETTER_AUTH_SECRET=

# One-time migration passcode for claiming mail synced before multi-user auth.
# It is not used for normal sign-in and can be removed after migration.
RBMAIL_ACCESS_PASSWORD=

# Optional. When omitted locally, rb/mail creates a private key in data/master.key.
# On hosted deployments, set a stable 32-byte base64 key.
RBMAIL_MASTER_KEY=
RBMAIL_DATA_DIR=./data

# Google Cloud OAuth 2.0 Web application credentials.
# Primary sign-in callback: ${APP_URL}/api/auth/callback/google
# Additional-mailbox callback: ${APP_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra multi-tenant Web application credentials.
# Primary sign-in callback: ${APP_URL}/api/auth/callback/microsoft
# Additional-mailbox callback: ${APP_URL}/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Protects scheduled sync in hosted environments.
CRON_SECRET=
